BRAVE_API_KEY=klucz_brave_search_api
LLM_API_KEY=klucz_api_llm
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=glm-4.5-flash
LLM_MODEL_EXTRACT=glm-4.5-flash
SEARCH_DAYS_BACK=5
RESULTS_PER_DORK=20
# Rozmiar dziennego okna skanu BIP-ów samorządowych (Faza 0b; domyślnie 100)
# JST_WINDOW=100
# Dodatkowe dorki oddzielone | (opcjonalne) - np. per konkretny BIP/spółkę.
# Uwaga: Brave nie wspiera inurl:/filetype:/site: (site: działa tylko w DDG),
# więc dla Brave używaj dorków frazowych z nazwą domeny w treści zapytania.
# EXTRA_DORKS=site:bip.grudziadz.pl "rady nadzorczej"|"ogłoszenie o naborze" "Grudziądz"

# --- Powiadomienia (opcjonalne) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
NOTIFY_EMAIL_TO=
